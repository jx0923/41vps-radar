# 站点与抓取配置模板
#
# 用法：复制为 .env 并按需修改；或在 systemd/cron/Actions 中直接设置环境变量。
# 全部为可选 —— 不设置时使用代码里的默认值。

# ---------------------------------------------------------------------------
# 站点与域名（部署到自有域名时改这里，无需改代码）
# ---------------------------------------------------------------------------

# 站点标题
LDR_SITE_TITLE=VPS 活动雷达

# 站点副标题/描述（会写入 <meta name="description">）
LDR_SITE_DESC=自动汇总 LowEndTalk / LowEndBox 的 VPS 优惠活动，标注折扣力度、循环折扣与库存状态。

# 站点根地址（末尾不要带 /）
# 设置后会生成 canonical 链接、绝对 sitemap URL 与 robots.txt 里的 Sitemap 行。
# 留空则使用相对路径，适合先本地预览。
# 例：LDR_SITE_URL=https://deals.example.com
LDR_SITE_URL=

# 页脚附加说明（如联系方式、备案号）
LDR_SITE_FOOTER=

# ---------------------------------------------------------------------------
# 路径（一般无需修改）
# ---------------------------------------------------------------------------

# LDR_DATA_DIR=./data
# LDR_SITE_DIR=./site

# ---------------------------------------------------------------------------
# 抓取行为
# ---------------------------------------------------------------------------

# HTTP 超时（秒）与重试次数
# LDR_HTTP_TIMEOUT=30
# LDR_HTTP_RETRIES=3

# 数据源（可替换为镜像地址）
# LDR_LET_FEED=https://lowendtalk.com/categories/offers/feed.rss
# LDR_LEB_FEED=https://lowendbox.com/feed/

# ---------------------------------------------------------------------------
# 联盟推广链接（可选）
# ---------------------------------------------------------------------------
# 厂商域名 -> 你自己的推广链接。用户通过它下单，你拿佣金。
#
# 默认留空 = 完全不影响现有行为（用原始链接）。
# 填一家生效一家，可逐个开启。
#
# 格式：JSON，键是厂商域名（可带 www），值是**完整**推广链接。
# 每家参数格式不同，不做拼接猜测 —— 必须给完整链接。
#
# 例：
# LDR_AFFILIATES={"racknerd.com":"https://my.racknerd.com/aff.php?aff=123",\
# "cloudcone.com":"https://cloudcone.com/?aff=456"}
#
# 匹配规则
#   my.racknerd.com / www.racknerd.com / billing.racknerd.com
#   都会命中 racknerd.com 这条规则。
#
# ⚠️ 启用前请确认各家条款：多数禁止自己下单赚自己佣金、脚本批量注册、
#    竞品品牌词广告。另建议在站点上明示「部分链接含推广佣金」——
#    佣金由商家从利润中出，不影响用户支付价格。
LDR_AFFILIATES=

# ---------------------------------------------------------------------------
# 部署（供 GitHub Actions 使用；在此仅作说明）
# ---------------------------------------------------------------------------
# Actions 里这些配在仓库 Settings → Secrets and variables → Actions：
#   Variables: LDR_SITE_TITLE / LDR_SITE_URL / LDR_DEPLOY_HOST /
#              LDR_DEPLOY_USER / LDR_DEPLOY_PATH / LDR_DEPLOY_PORT
#   Secrets:   LDR_DEPLOY_SSH_KEY
